<!-- Example -->


<group name="sysmon,custom,thesis,">

  <!-- ─── PART A: INDIVIDUAL TECHNIQUE RULES ─────────────────────── -->
  <!-- 100001: T1059.001 PowerShell Encoded Command                    -->
  <!-- Fires A1, B1 Phase B, B2 Phase B, B6 Step 2                   -->
  <rule id="100001" level="12">
    <if_sid>92057</if_sid>
    <description>Sysmon: PowerShell encoded command or v2 downgrade (T1059.001)</description>
    <group>powershell,execution,fileless,thesis,</group>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <!-- 100002 T1218.005 Mshta LOLBin                                  -->
  <!-- Fires A2, B3 Phase B                                           -->
  <rule id="100002" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(http:|https:|javascript:|vbscript:)</field>
    <field name="win.eventdata.image" type="pcre2">(?i)mshta\.exe</field>
    <description>Sysmon: Mshta executing remote URL or inline script (T1218.005)</description>
    <group>lolbin,execution,thesis,</group>
    <mitre><id>T1218.005</id></mitre>
  </rule>

  <!-- 100003 T1047 WMI Child Process                                 -->
  <!-- Fires A3, B3 Phase C, B4 Phase C                              -->
  <rule id="100003" level="12">
    <if_sid>92069</if_sid>
    <field name="win.eventdata.ruleName" type="pcre2">T1047</field>
    <description>Sysmon: Shell spawned by WmiPrvSE.exe (T1047)</description>
    <group>wmi,execution,lateral_movement,thesis,</group>
    <mitre><id>T1047</id></mitre>
  </rule>

  <!-- 100004 T1055.001 CreateRemoteThread Injection                  -->
  <!-- Fires A4, B1 Phase C                                           -->
  <rule id="100004" level="15">
    <if_sid>61610</if_sid>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)^(?!.*MsMpEng\.exe)(?!.*svchost\.exe)(?!.*csrss\.exe)(?!.*lsass\.exe)</field>
    <description>Sysmon: CreateRemoteThread process injection (T1055.001)</description>
    <group>injection,fileless,critical,thesis,</group>
    <mitre><id>T1055.001</id></mitre>
  </rule>

  <!-- 100005 T1055.001 Process Access supplementary                  -->
  <rule id="100005" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)(0x1f[0-9a-f]{4}|0x[0-9a-f]*[2638][0-9a-f]{3})</field>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)^(?!.*MsMpEng\.exe)(?!.*svchost\.exe)(?!.*wazuh-agent\.exe)(?!.*lsass\.exe)</field>
    <description>Sysmon: Process accessed with write/exec rights (T1055.001)</description>
    <group>injection,fileless,thesis,</group>
    <mitre><id>T1055.001</id></mitre>
  </rule>

  <!-- 100006 T1218.010 Regsvr32 Squiblydoo                          -->
  <!-- Fires A5, B3 Phase D                                           -->
  <rule id="100006" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)regsvr32\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(/i:https?|/i:ftp|scrobj)</field>
    <description>Sysmon: Regsvr32 Squiblydoo via remote URL (T1218.010)</description>
    <group>lolbin,execution,thesis,</group>
    <mitre><id>T1218.010</id></mitre>
  </rule>

  <!-- 100007 T1546.003 WMI Event Consumer (Event ID 20)             -->
  <!-- Fires A6, B2 Phase D, B4 Phase D                              -->
  <rule id="100007" level="12">
    <if_sid>89501</if_sid>
    <description>Sysmon: WMI event consumer registered (T1546.003)</description>
    <group>wmi,persistence,fileless,thesis,</group>
    <mitre><id>T1546.003</id></mitre>
  </rule>

  <!-- 100016 T1546.003 WMI Event Filter (Event ID 19)               -->
  <rule id="100016" level="12">
    <if_sid>61647</if_sid>
    <field name="win.system.eventID">^19$</field>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <description>Sysmon: WMI event filter registered (T1546.003)</description>
    <group>wmi,persistence,fileless,thesis,</group>
    <mitre><id>T1546.003</id></mitre>
  </rule>

  <!-- 100017 T1546.003 WMI Filter-Consumer Binding (Event ID 21)    -->
  <rule id="100017" level="12">
    <if_sid>61649</if_sid>
    <field name="win.system.eventID">^21$</field>
    <field name="win.system.channel">^Microsoft-Windows-Sysmon/Operational$</field>
    <description>Sysmon: WMI filter-consumer binding registered (T1546.003)</description>
    <group>wmi,persistence,fileless,thesis,</group>
    <mitre><id>T1546.003</id></mitre>
  </rule>

  <!-- 100008 T1564.004 Alternate Data Streams (Event ID 15)         -->
  <rule id="100008" level="10">
    <if_sid>61617</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2" negate="yes">(?i)Zone\.Identifier</field>
    <description>Sysmon: Suspicious NTFS ADS created (T1564.004)</description>
    <group>defence_evasion,hiding,thesis,</group>
    <mitre><id>T1564.004</id></mitre>
  </rule>

  <!-- 100009 T1562.002 Script Block Logging Disabled (Event ID 13)  -->
  <!-- Fires A9, B1 Phase A anchor, B4 Phase B anchor, B6 Step 3    -->
  <rule id="100009" level="12">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(ScriptBlockLogging|ModuleLogging|EventLog)</field>
    <description>Sysmon: PowerShell logging disabled via registry (T1562.002)</description>
    <group>defence_evasion,logging_impairment,thesis,</group>
    <mitre><id>T1562.002</id></mitre>
  </rule>

  <!-- 100010 T1562.001 Security Monitoring Disabled (Event ID 13)   -->
  <!-- Fires B4 Phase B anchor                                        -->
  <rule id="100010" level="12">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(Defender|MpEngine|DisableAntiSpyware|DisableRealtimeMonitoring|CurrentVersion\\Policies)</field>
    <description>Sysmon: Security monitoring disabled via registry (T1562.001)</description>
    <group>defence_evasion,security_impairment,thesis,</group>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <!-- 100011 T1070.001 Log Clearing via Wevtutil                    -->
  <!-- Fires B2 Phase E terminal anchor                               -->
  <rule id="100011" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)wevtutil\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\bcl\b|clear-log)</field>
    <description>Sysmon: Event log clearing via wevtutil (T1070.001)</description>
    <group>anti_forensics,indicator_removal,thesis,</group>
    <mitre><id>T1070.001</id></mitre>
  </rule>

  <!-- 100014 T1105 Wazuh FIM Staging File Anchor                    -->
  <!-- Fires A8, B6 Step 1                                            -->
  <rule id="100014" level="10">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)(\\Windows\\Temp\\|\\AppData\\|\\ProgramData\\).*\.(ps1|hta|vbs|bat|exe|dll)$</field>
    <description>Wazuh FIM: Suspicious script staged in attacker directory (T1105)</description>
    <group>fim,staging,thesis,</group>
    <mitre><id>T1105</id></mitre>
  </rule>


  <!-- ─── PART B: CHAINED CORRELATION RULES ──────────────────────── -->
  <!-- B1 T1562.002 -> T1059.001 -> T1055.001      -->
  <rule id="100020" level="13" timeframe="600">
    <if_matched_sid>100009</if_matched_sid>
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-EncodedCommand)</field>
    <description>Chained B1(A+B): Logging disabled then encoded PowerShell</description>
    <group>chained,b1,thesis,</group>
    <mitre><id>T1562.002</id><id>T1059.001</id></mitre>
  </rule>

  <rule id="100021" level="15" timeframe="600">
    <if_matched_sid>100020</if_matched_sid>
    <if_sid>100004</if_sid>
    <description>FULL CHAIN B1: Evasion, PowerShell, injection</description>
    <group>chained,b1,full_chain,critical,thesis,</group>
    <mitre><id>T1562.002</id><id>T1059.001</id><id>T1055.001</id></mitre>
  </rule>

  <!-- B2 T1059.001 -> T1546.003 -> T1070.001       -->
  <rule id="100022" level="13" timeframe="600">
    <if_matched_sid>100001</if_matched_sid>
    <if_sid>89501</if_sid>
    <description>Chained B2(B+D): PowerShell then WMI persistence</description>
    <group>chained,b2,thesis,</group>
    <mitre><id>T1059.001</id><id>T1546.003</id></mitre>
  </rule>

  <rule id="100023" level="14" timeframe="600">
    <if_matched_sid>100022</if_matched_sid>
    <if_sid>100011</if_sid>
    <description>FULL CHAIN B2: Execute, persist, destroy evidence</description>
    <group>chained,b2,full_chain,thesis,</group>
    <mitre><id>T1059.001</id><id>T1546.003</id><id>T1070.001</id></mitre>
  </rule>

  <!-- B3 T1218.005 -> T1047 -> T1218.010         -->
  <rule id="100024" level="13" timeframe="900">
    <if_matched_sid>100002</if_matched_sid>
    <if_sid>92069</if_sid>
    <description>Chained B3(B+C): Mshta then WMI child process</description>
    <group>chained,b3,thesis,</group>
    <mitre><id>T1218.005</id><id>T1047</id></mitre>
  </rule>

  <rule id="100025" level="14" timeframe="900">
    <if_matched_sid>100024</if_matched_sid>
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)regsvr32\.exe</field>
    <description>FULL CHAIN B3: LOLBin chain mshta, WMI, regsvr32</description>
    <group>chained,b3,full_chain,thesis,</group>
    <mitre><id>T1218.005</id><id>T1047</id><id>T1218.010</id></mitre>
  </rule>

  <!-- B4 T1562.002 -> T1047 -> T1546.003           -->
  <rule id="100026" level="13" timeframe="600">
    <if_matched_sid>100009</if_matched_sid>
    <if_sid>92069</if_sid>
    <description>Chained B4(B+C): Logging disabled then WMI execution</description>
    <group>chained,b4,thesis,</group>
    <mitre><id>T1562.002</id><id>T1047</id></mitre>
  </rule>

  <rule id="100027" level="14" timeframe="600">
    <if_matched_sid>100026</if_matched_sid>
    <if_sid>89501</if_sid>
    <description>FULL CHAIN B4: Evasion, WMI execution, WMI persistence</description>
    <group>chained,b4,full_chain,thesis,</group>
    <mitre><id>T1562.002</id><id>T1047</id><id>T1546.003</id></mitre>
  </rule>

  <!-- B6 T1105 -> T1059.001 -> T1562.002          -->
  <rule id="100029" level="13" timeframe="600">
    <if_matched_sid>100014</if_matched_sid>
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <description>Chained B6(1+2): Staging file then PowerShell execution</description>
    <group>chained,b6,thesis,</group>
    <mitre><id>T1105</id><id>T1059.001</id></mitre>
  </rule>

  <rule id="100030" level="14" timeframe="600">
    <if_matched_sid>100029</if_matched_sid>
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(ScriptBlockLogging|ModuleLogging|EventLog)</field>
    <description>FULL CHAIN B6: Stage, execute, disable logging</description>
    <group>chained,b6,full_chain,thesis,</group>
    <mitre><id>T1105</id><id>T1059.001</id><id>T1562.002</id></mitre>
  </rule>

</group>
         